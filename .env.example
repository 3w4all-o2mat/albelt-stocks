# =============================================================================
# Albelt Stocks — environment template
# Copy this file to `.env.production` on the VPS and fill in the real values.
# NEVER commit `.env.production` (it is gitignored).
# =============================================================================
#
# IMPORTANT — DATABASE HOSTING ON THE VPS
# ---------------------------------------
# On the VPS, the PostgreSQL container runs on a user-defined Docker bridge
# network called `odoo-network`. The `app` container is attached to that
# same network by docker-compose / deploy.sh, so Docker's built-in DNS lets
# us reach Postgres by its SERVICE / CONTAINER name (no `host.docker.internal`).
#
# To find the actual name of your Postgres container on `odoo-network`:
#   docker network inspect odoo-network \
#     --format '{{range .Containers}}{{.Name}} {{end}}'
# Example output:  odoo-db  pg16  postgres
# Use one of those names in the URLs below as `<postgres_container>`.
#
# Locally (on your Mac) you keep the current setup — Next.js runs on the
# host, not inside a container, so `localhost` still points at the host's
# port-forwarded Postgres:
#   DATABASE_URL=postgresql://smail:odoo@localhost:5432/postgres
#   DATABASE_URL_ODOO=postgresql://smail:odoo@localhost:5432/albelt-aout
# =============================================================================


# ---- Database (main app DB) ------------------------------------------------
# Replace `<postgres_container>` with the real name of your Postgres
# container on the `odoo-network` bridge.
DATABASE_URL=postgresql://smail:odoo@<postgres_container>:5432/postgres

# ---- Database (Odoo integration DB) ----------------------------------------
# Same Postgres instance, different database name.
DATABASE_URL_ODOO=postgresql://smail:odoo@<postgres_container>:5432/albelt-aout

# ---- Default Odoo mappings (used when no app user is mapped yet) ---------
DEFAULT_USER_ID=1
DEFAULT_COMPANY_ID=1
DEFAULT_ATELIER=Atelier A

# ---- Auth -----------------------------------------------------------------
# Membership / JWT auth (used by lib/auth/**)
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRY=8h
BCRYPT_ROUNDS=12

# Optional: cookie/session tweaks
# AUTH_COOKIE_NAME=albelt_session
